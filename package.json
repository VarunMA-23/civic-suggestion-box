{
  "name": "civic-suggestion-box",
  "version": "1.0.0",
  "private": true,
  "description": "Digital suggestion box for local governance (FastAPI + Next.js)",
  "scripts": {
    "dev": "pnpm --filter civic-suggestion-box-frontend dev",
